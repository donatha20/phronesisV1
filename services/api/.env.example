# ---- Core ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://phronesis:phronesis@localhost:5432/phronesis
REDIS_URL=redis://localhost:6379/0

# ---- Frontend (SPA) origin ----
FRONTEND_URL=http://localhost:3000

# ---- CORS / CSRF (web client origin) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Set to "None" (with HTTPS) when the SPA and API are on different registrable domains
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# ---- JWT ----
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=14
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# ---- Field-level encryption (Google refresh tokens). Fernet key, base64, 32 bytes ----
FIELD_ENCRYPTION_KEY=

# ---- Login with Google (server-side authorization-code flow, identity only) ----
# Authorized redirect URI in Google Cloud Console must match GOOGLE_OIDC_REDIRECT_URI exactly.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---- Google Workspace data broker (Drive / Calendar / Meet) ----
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
GOOGLE_WORKSPACE_SCOPES=https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/meetings.space.created

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Storage (prod: S3). Leave blank for local filesystem ----
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# ---- Feature flags ----
ASSISTANT_FEATURE_ENABLED=false

# ---- Observability ----
SENTRY_DSN=
